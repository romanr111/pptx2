{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pptx-deck/spec.schema.json",
  "title": "pptx-deck slide spec",
  "description": "Everything build_deck.py can execute for one slide, and nothing more. Layout/animation decisions are made upstream (by a human or the designer skill) and frozen into this file.",
  "type": "object",
  "required": ["spec_version", "slide", "elements"],
  "additionalProperties": false,
  "properties": {
    "spec_version": { "const": 1 },
    "meta": {
      "type": "object",
      "description": "Free-text designer intent/rationale. Ignored by the builder EXCEPT meta.doc_props {title, author, subject}, which the builder stamps into the .pptx core properties (docProps) so deliverables never ship with library-boilerplate metadata. When out/styleguide_profile.json exists, designers should record meta.styleguide_profile and meta.styleguide_application so lint can verify the slide used the template/styleguide taste contract.",
      "additionalProperties": true
    },
    "slide": {
      "type": "object",
      "required": ["width_emu", "height_emu"],
      "additionalProperties": false,
      "properties": {
        "width_emu": { "type": "integer", "exclusiveMinimum": 0 },
        "height_emu": { "type": "integer", "exclusiveMinimum": 0 }
      }
    },
    "background": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["asset", "box"],
          "additionalProperties": false,
          "properties": {
            "asset": { "type": "string" },
            "box": { "$ref": "#/$defs/box" }
          }
        }
      ]
    },
    "packaging": {
      "type": "object",
      "description": "Template-native packaging decisions (frozen upstream like everything else): which theme the built package carries in PowerPoint's color/font pickers, and package hygiene. Executed by packaging.apply_packaging after save.",
      "additionalProperties": false,
      "properties": {
        "theme_source": {
          "oneOf": [
            {
              "type": "object",
              "description": "Authoritative path: graft the theme out of the organizer's real .pptx template.",
              "required": ["kind", "path"],
              "additionalProperties": false,
              "properties": {
                "kind": { "const": "template" },
                "path": { "type": "string" },
                "theme_index": { "type": "integer", "minimum": 0, "default": 0 }
              }
            },
            {
              "type": "object",
              "description": "Fallback path for reference-only events: the designer maps the reference palette/typography to theme slots explicitly.",
              "required": ["kind", "colors"],
              "additionalProperties": false,
              "properties": {
                "kind": { "const": "synthesized" },
                "name": { "type": "string" },
                "colors": {
                  "type": "object",
                  "required": ["dk1", "lt1", "dk2", "lt2", "accent1", "accent2", "accent3", "accent4", "accent5", "accent6"],
                  "additionalProperties": false,
                  "patternProperties": {
                    "^(dk1|lt1|dk2|lt2|accent[1-6])$": { "type": "string", "pattern": "^[0-9A-Fa-f]{6}$" }
                  }
                },
                "major_font": { "type": "string" },
                "minor_font": { "type": "string" }
              }
            }
          ]
        },
        "strip_unused_layouts": { "type": "boolean", "default": true },
        "media_optimization": {
          "type": "object",
          "description": "Opt-in build-time media pass (forensic F5: metadata-only crops ship full-size pixels). Bakes cover-fit crops into actual pixels and downscales images to a DPI budget before embedding; originals in assets/ are never touched. Omit for byte-faithful embedding.",
          "additionalProperties": false,
          "properties": {
            "dpi_budget": { "type": "number", "exclusiveMinimum": 0, "default": 200 },
            "jpeg_quality": { "type": "integer", "minimum": 1, "maximum": 100, "default": 88 },
            "bake_crops": { "type": "boolean", "default": true }
          }
        },
        "max_package_mb": {
          "type": "number", "exclusiveMinimum": 0,
          "description": "Deck-size budget; lint_deck warns when the built package exceeds it."
        },
        "embed_fonts": {
          "type": "array",
          "description": "Fonts to embed into the package (ppt/fonts/*.fntdata + embeddedFontLst) so the deck renders as designed on machines without them installed. Paths are project-root-relative TTFs per style slot. LICENSE GATE: lint warns when no license evidence (OFL.txt/LICENSE/COPYING) sits next to a font file — verify redistribution rights before embedding (Geologica/Noto/Roboto are OFL; HeliosCond's license is unverified).",
          "items": {
            "type": "object",
            "required": ["family"],
            "additionalProperties": false,
            "properties": {
              "family": { "type": "string" },
              "regular": { "type": "string" },
              "bold": { "type": "string" },
              "italic": { "type": "string" },
              "bold_italic": { "type": "string" }
            }
          }
        }
      }
    },
    "elements": {
      "type": "array",
      "items": { "$ref": "#/$defs/element" }
    },
    "animations": {
      "type": "array",
      "items": { "$ref": "#/$defs/animation_step" }
    },
    "image_briefs": {
      "type": "array",
      "description": "Structured wanted-but-missing images (the AI-decided 'an image belongs here' judgment, made executable). Filling a brief = drop a file at its `asset` path and rebuild — no spec edit. While the file is missing, the builder renders a labeled placeholder panel so the hole is visible in dev renders, and lint_render errors unless the brief id is listed in meta.acknowledged_briefs (an explicit 'ships without it' decision, which also suppresses the placeholder). Web/generated fills land under assets/generated/ with a provenance sidecar (asset.ext.json). Missing provenance is an error; verified medical/anatomical fills warn so user review remains explicit (see lint_render).",
      "items": {
        "type": "object",
        "required": ["id", "box", "asset", "subject", "aspect", "medical_class"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-zA-Z0-9_-]+$" },
          "box": { "$ref": "#/$defs/box" },
          "z": { "type": "integer", "default": 0 },
          "asset": {
            "type": "string",
            "description": "Where the future image file is expected (conventionally assets/generated/<name>.png). Existing file = brief is filled and placed as an image."
          },
          "subject": { "type": "string" },
          "style": {
            "type": "string",
            "description": "Style constraints locked to the event's identity: palette, mood, lighting. What a generator or photographer needs to stay on-brand."
          },
          "aspect": { "type": "string", "description": "e.g. \"3:4\", \"16:9\"" },
          "negative": { "type": "string", "default": "no text, no watermarks, no logos" },
          "medical_class": {
            "enum": ["decorative", "conceptual", "anatomical"],
            "description": "Review gating: anatomical AI fills lint as error until a human sign-off is recorded in meta.image_reviews; decorative/conceptual only warn."
          },
          "rationale": { "type": "string" },
          "fit": { "enum": ["stretch", "contain", "cover"], "default": "cover" },
          "anchor": { "enum": ["top", "bottom", "left", "right", "center"], "default": "center" }
        }
      }
    }
  },
  "$defs": {
    "box": {
      "type": "object",
      "required": ["x", "y", "cx", "cy"],
      "additionalProperties": false,
      "properties": {
        "x": { "type": "integer" },
        "y": { "type": "integer" },
        "cx": { "type": "integer", "exclusiveMinimum": 0 },
        "cy": { "type": "integer", "exclusiveMinimum": 0 },
        "allow_offslide_bleed": {
          "type": "array",
          "items": { "enum": ["top", "bottom", "left", "right"] }
        }
      }
    },
    "run": {
      "type": "object",
      "required": ["text", "font", "size_pt", "color"],
      "additionalProperties": false,
      "properties": {
        "text": { "type": "string" },
        "font": { "type": "string" },
        "size_pt": { "type": "number", "exclusiveMinimum": 0 },
        "color": { "type": "string", "pattern": "^[0-9A-Fa-f]{6}$" },
        "bold": { "type": "boolean" },
        "tracking_pt": { "type": "number" }
      }
    },
    "paragraph": {
      "type": "object",
      "required": ["lines"],
      "additionalProperties": false,
      "properties": {
        "lines": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/run" }
        },
        "line_spacing_pt": { "type": "number", "exclusiveMinimum": 0 },
        "space_before_pt": { "type": "number", "minimum": 0 },
        "bullet": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["char", "hang_emu", "font"],
              "additionalProperties": false,
              "properties": {
                "char": { "type": "string", "minLength": 1, "maxLength": 1 },
                "hang_emu": { "type": "integer", "minimum": 0 },
                "font": { "type": "string" },
                "color": {
                  "type": "string",
                  "pattern": "^[0-9A-Fa-f]{6}$",
                  "description": "Explicit bullet-mark color. Omitted = renderer default (which differs across PowerPoint/LibreOffice — set this whenever the bullet should match a design color)."
                }
              }
            }
          ]
        }
      }
    },
    "element": {
      "type": "object",
      "required": ["id", "type", "box"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_-]+$" },
        "type": { "enum": ["image", "textbox", "table", "chart", "shape"] },
        "role": {
          "type": "string",
          "description": "Free-text semantic tag (title, subtitle, credentials, citation, figure, logo...). Used for cross-slide consistency checks and template-conformance review, not by the builder itself."
        },
        "z": { "type": "integer", "default": 0 },
        "box": { "$ref": "#/$defs/box" }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "image" } } },
          "then": {
            "required": ["asset"],
            "properties": {
              "asset": { "type": "string" },
              "fit": { "enum": ["stretch", "contain", "cover"], "default": "stretch" },
              "anchor": {
                "enum": ["top", "bottom", "left", "right", "center"],
                "default": "center",
                "description": "Only meaningful with fit:contain (which side of the box the smaller, aspect-correct image hugs) or fit:cover (which side survives the crop). Ignored for fit:stretch."
              }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "shape" } } },
          "then": {
            "description": "A plain vector shape -- no image asset needed. For decorative accents (e.g. theme-colored dots/bubbles) or solid panels, not for icons or anything needing real detail.",
            "required": ["shape_type", "fill"],
            "properties": {
              "shape_type": { "enum": ["ellipse", "rectangle", "rounded_rectangle"] },
              "fill": {
                "type": "object",
                "required": ["color"],
                "additionalProperties": false,
                "properties": {
                  "color": { "type": "string", "pattern": "^[0-9A-Fa-f]{6}$" },
                  "color2": {
                    "type": "string",
                    "pattern": "^[0-9A-Fa-f]{6}$",
                    "description": "If set, a 2-stop linear gradient from color to color2 instead of a solid fill (e.g. a lighter tint to hint at a glossy sphere)."
                  },
                  "gradient_angle": { "type": "number", "description": "Degrees, only used when color2 is set." }
                }
              },
              "line": {
                "oneOf": [
                  { "type": "null" },
                  {
                    "type": "object",
                    "required": ["color", "width_pt"],
                    "additionalProperties": false,
                    "properties": {
                      "color": { "type": "string", "pattern": "^[0-9A-Fa-f]{6}$" },
                      "width_pt": { "type": "number", "exclusiveMinimum": 0 }
                    }
                  }
                ]
              }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "textbox" } } },
          "then": {
            "required": ["paragraphs"],
            "properties": {
              "paragraphs": {
                "type": "array",
                "minItems": 1,
                "items": { "$ref": "#/$defs/paragraph" }
              },
              "wrap": { "enum": ["none", "square"], "default": "none" },
              "insets_zero": { "type": "boolean", "default": true }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "table" } } },
          "then": {
            "required": ["table"],
            "properties": {
              "table": {
                "type": "object",
                "required": ["columns_emu", "rows", "style"],
                "additionalProperties": false,
                "properties": {
                  "columns_emu": {
                    "type": "array", "minItems": 1,
                    "items": { "type": "integer", "exclusiveMinimum": 0 }
                  },
                  "rows": {
                    "type": "array", "minItems": 1,
                    "description": "Row-major cell text. rows[0] is the header when header:true.",
                    "items": { "type": "array", "minItems": 1, "items": { "type": "string" } }
                  },
                  "header": { "type": "boolean", "default": true },
                  "row_height_emu": { "type": "integer", "exclusiveMinimum": 0 },
                  "style": {
                    "type": "object",
                    "description": "All styling is an upstream decision -- the builder never invents table colors/fonts.",
                    "required": ["font", "size_pt", "text_color"],
                    "additionalProperties": false,
                    "properties": {
                      "font": { "type": "string" },
                      "size_pt": { "type": "number", "exclusiveMinimum": 0 },
                      "text_color": { "type": "string", "pattern": "^[0-9A-Fa-f]{6}$" },
                      "header_fill": { "type": "string", "pattern": "^[0-9A-Fa-f]{6}$" },
                      "header_color": { "type": "string", "pattern": "^[0-9A-Fa-f]{6}$" },
                      "header_bold": { "type": "boolean", "default": true },
                      "row_fill": { "type": "string", "pattern": "^[0-9A-Fa-f]{6}$" },
                      "alt_row_fill": { "type": "string", "pattern": "^[0-9A-Fa-f]{6}$" },
                      "border_color": { "type": "string", "pattern": "^[0-9A-Fa-f]{6}$" },
                      "border_pt": { "type": "number", "exclusiveMinimum": 0 }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "chart" } } },
          "then": {
            "description": "Reserved for a later phase. Not implemented by build_deck.py yet -- rejected at validation, never silently ignored.",
            "properties": { "data": { "type": "object" } }
          }
        }
      ]
    },
    "animation_step": {
      "type": "object",
      "required": ["step", "targets", "effect"],
      "additionalProperties": false,
      "properties": {
        "step": { "type": "integer", "minimum": 1 },
        "targets": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "effect": { "enum": ["fade", "appear", "wipe", "fly"] },
        "direction": { "enum": ["left", "right", "top", "bottom"] },
        "trigger": { "enum": ["click", "with_previous", "after_previous"], "default": "click" },
        "duration_ms": { "type": "integer", "exclusiveMinimum": 0, "default": 500 }
      }
    }
  }
}
